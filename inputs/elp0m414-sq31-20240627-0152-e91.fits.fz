    EXTNAME = 'BPM     '                                                            EXTVER  =                    1                                                  END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀<␀␀␀␀␀␀Z␀␀␀␀␀␀x␀␀␀␀␀␀–␀␀␀␀␀␀´␀␀␀␀␀␀Ò␀␀␀␀␀␀ð␀␀␀␀␀␀␀␀␀␀,␀␀␀␀␀J␀␀␀␀␀h␀␀␀␀␀†␀␀␀"␀␀¤␀␀␀"␀␀Æ␀␀␀"␀␀è␀␀␀"␀␀
